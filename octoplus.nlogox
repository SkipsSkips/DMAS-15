    <note x="5" y="294" backgroundDark="0" fontSize="11" width="230" markdown="false" height="18" textColorDark="-1" textColorLight="-15461356" backgroundLight="0">MOVEMENT AND DETECTION</note>
    <slider x="5" step="0.05" y="316" max="2" width="230" display="prey-speed-setting" height="50" min="0" direction="Horizontal" default="0.6" variable="prey-speed-setting" units="patches/tick"></slider>
    <slider x="5" step="0.05" y="368" max="2" width="230" display="predator-speed-setting" height="50" min="0" direction="Horizontal" default="0.8" variable="predator-speed-setting" units="patches/tick"></slider>
    <slider x="5" step="0.5" y="420" max="25" width="230" display="predator-detection-radius-setting" height="50" min="1" direction="Horizontal" default="10" variable="predator-detection-radius-setting" units="patches"></slider>
    <slider x="5" step="1" y="472" max="20" width="230" display="prey-reaction-time-setting" height="50" min="0" direction="Horizontal" default="2" variable="prey-reaction-time-setting" units="ticks"></slider>
    <note x="5" y="530" backgroundDark="0" fontSize="11" width="230" markdown="false" height="18" textColorDark="-1" textColorLight="-15461356" backgroundLight="0">DETECTION MODEL</note>
    <slider x="5" step="0.05" y="552" max="1" width="230" display="cover-impact-strength" height="50" min="0" direction="Horizontal" default="0.8" variable="cover-impact-strength"></slider>
    <slider x="5" step="0.01" y="604" max="1" width="230" display="hide-detection-multiplier" height="50" min="0" direction="Horizontal" default="0.15" variable="hide-detection-multiplier"></slider>
    <slider x="5" step="0.1" y="656" max="5" width="230" display="motion-detection-multiplier" height="50" min="0" direction="Horizontal" default="1.5" variable="motion-detection-multiplier"></slider>
    <note x="240" y="8" backgroundDark="0" fontSize="11" width="230" markdown="false" height="18" textColorDark="-1" textColorLight="-15461356" backgroundLight="0">ENVIRONMENT</note>
    <chooser x="240" y="30" height="60" variable="cover-amount-category" current="1" width="230" display="cover-amount-category"><choice type="string" value="low"></choice><choice type="string" value="medium"></choice><choice type="string" value="high"></choice></chooser>
    <chooser x="240" y="95" height="60" variable="cover-arrangement" current="1" width="230" display="cover-arrangement"><choice type="string" value="uniform"></choice><choice type="string" value="patchy"></choice><choice type="string" value="mixed"></choice></chooser>
    <note x="240" y="160" backgroundDark="0" fontSize="11" width="230" markdown="false" height="18" textColorDark="-1" textColorLight="-15461356" backgroundLight="0">PREY STRATEGY</note>
    <chooser x="240" y="182" height="60" variable="octopus-strategy-mode" current="0" width="230" display="octopus-strategy-mode"><choice type="string" value="adaptive-dmas"></choice><choice type="string" value="hide"></choice><choice type="string" value="flee"></choice><choice type="string" value="still"></choice><choice type="string" value="seek-cover"></choice><choice type="string" value="experimental-assigned"></choice></chooser>
    <note x="240" y="247" backgroundDark="0" fontSize="11" width="230" markdown="false" height="18" textColorDark="-1" textColorLight="-15461356" backgroundLight="0">ADAPTIVE DECISION THRESHOLDS</note>
    <slider x="240" step="0.01" y="269" max="1" width="230" display="minimum-decision-score" height="50" min="0" direction="Horizontal" default="0.08" variable="minimum-decision-score"></slider>
    <slider x="240" step="0.01" y="321" max="1" width="230" display="minimum-cover-target" height="50" min="0" direction="Horizontal" default="0.6" variable="minimum-cover-target"></slider>
    <slider x="240" step="0.01" y="373" max="1" width="230" display="hide-cover-threshold" height="50" min="0" direction="Horizontal" default="0.55" variable="hide-cover-threshold"></slider>
    <note x="240" y="431" backgroundDark="0" fontSize="11" width="230" markdown="false" height="18" textColorDark="-1" textColorLight="-15461356" backgroundLight="0">REPRODUCTION</note>
    <switch x="240" y="453" height="40" on="true" variable="enable-reproduction?" width="230" display="enable-reproduction?"></switch>
    <note x="240" y="500" backgroundDark="0" fontSize="11" width="230" markdown="false" height="18" textColorDark="-1" textColorLight="-15461356" backgroundLight="0">DISPLAY AND PERFORMANCE</note>
    <switch x="240" y="522" height="40" on="true" variable="show-predator-radii?" width="230" display="show-predator-radii?"></switch>
    <switch x="240" y="567" height="40" on="true" variable="show-state-labels?" width="230" display="show-state-labels?"></switch>
    <switch x="240" y="612" height="40" on="true" variable="update-live-plots?" width="230" display="update-live-plots?"></switch>
    <note x="240" y="657" backgroundDark="0" fontSize="10" width="230" markdown="false" height="18" textColorDark="-1" textColorLight="-15461356" backgroundLight="0">Turn all three off for BehaviorSpace speed.</note>
    <view x="480" wrappingAllowedX="true" y="8" frameRate="30.0" minPycor="-25" height="565" showTickCounter="true" patchSize="11.0" fontSize="10" wrappingAllowedY="true" width="565" tickCounterLabel="ticks" maxPycor="25" updateMode="1" maxPxcor="25" minPxcor="-25"></view>
    <note x="1060" y="8" backgroundDark="0" fontSize="11" width="429" markdown="false" height="18" textColorDark="-1" textColorLight="-15461356" backgroundLight="0">SURVIVAL OUTCOMES</note>
    <monitor x="1060" precision="2" y="30" height="60" fontSize="11" width="143" display="founder survival %">founder-survival-rate</monitor>
    <monitor x="1207" precision="2" y="30" height="60" fontSize="11" width="143" display="capture rate %">capture-rate</monitor>
    <monitor x="1354" precision="2" y="30" height="60" fontSize="11" width="143" display="prey alive">count octopuses</monitor>
    <monitor x="1060" precision="0" y="95" height="60" fontSize="11" width="143" display="captures">total-captures</monitor>
    <monitor x="1207" precision="0" y="95" height="60" fontSize="11" width="143" display="births">total-births</monitor>
    <monitor x="1354" precision="0" y="95" height="60" fontSize="11" width="143" display="extinct at">extinction-time</monitor>
    <note x="1060" y="162" backgroundDark="0" fontSize="11" width="429" markdown="false" height="18" textColorDark="-1" textColorLight="-15461356" backgroundLight="0">ENVIRONMENT REALISED</note>
    <monitor x="1060" precision="2" y="184" height="60" fontSize="11" width="143" display="mean cover">realized-cover-mean</monitor>
    <monitor x="1207" precision="2" y="184" height="60" fontSize="11" width="143" display="usable cover %">cover-availability-percent</monitor>
    <monitor x="1354" precision="2" y="184" height="60" fontSize="11" width="143" display="dist. to cover">mean-distance-to-usable-cover</monitor>
    <note x="1060" y="251" backgroundDark="0" fontSize="11" width="429" markdown="false" height="18" textColorDark="-1" textColorLight="-15461356" backgroundLight="0">BEHAVIOUR: SHARE OF PREY-TICKS SPENT</note>
    <monitor x="1060" precision="2" y="273" height="60" fontSize="11" width="143" display="hide">hide-exposure-proportion</monitor>
    <monitor x="1207" precision="2" y="273" height="60" fontSize="11" width="143" display="flee">flee-exposure-proportion</monitor>
    <monitor x="1354" precision="2" y="273" height="60" fontSize="11" width="143" display="still">still-exposure-proportion</monitor>
    <plot x="1060" autoPlotX="true" yMax="100.0" autoPlotY="true" yAxis="prey" y="345" xMin="0.0" height="250" legend="true" xMax="100.0" yMin="0.0" width="437" xAxis="ticks" display="Prey Population by Active Strategy"><setup></setup><update></update><pen interval="1.0" mode="0" display="Hide" color="-14513374" legend="true"><setup></setup><update></update></pen><pen interval="1.0" mode="0" display="Flee" color="-2703872" legend="true"><setup></setup><update></update></pen><pen interval="1.0" mode="0" display="Still" color="-23296" legend="true"><setup></setup><update></update></pen><pen interval="1.0" mode="0" display="Seek Cover" color="-16736080" legend="true"><setup></setup><update></update></pen><pen interval="1.0" mode="0" display="Total" color="-15461356" legend="true"><setup></setup><update></update></pen></plot>
    <plot x="1060" autoPlotX="true" yMax="100.0" autoPlotY="true" yAxis="count" y="600" xMin="0.0" height="250" legend="true" xMax="100.0" yMin="0.0" width="437" xAxis="ticks" display="Population and Predation"><setup></setup><update></update><pen interval="1.0" mode="0" display="Prey" color="-23296" legend="true"><setup></setup><update></update></pen><pen interval="1.0" mode="0" display="Founders" color="-7579096" legend="true"><setup></setup><update></update></pen><pen interval="1.0" mode="0" display="Captures" color="-2742232" legend="true"><setup></setup><update></update></pen><pen interval="1.0" mode="0" display="Births" color="-14513374" legend="true"><setup></setup><update></update></pen></plot>
  </widgets>
