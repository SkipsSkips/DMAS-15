<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;; ====================================================================
;; OCTOPUS CAMOUFLAGE DMAS SIMULATION
;; Self-contained version: all parameters are defined in globals.
;; ====================================================================

globals [
  ;; Population settings
  initial-octopuses
  initial-predators

  ;; Movement and detection settings
  predator-detection-radius-setting
  predator-speed-setting
  prey-speed-setting
  prey-reaction-time-setting
  capture-distance

  ;; Predator search settings
  predator-wander-angle
  predator-search-speed-factor

  ;; Adaptive DMAS thresholds
  threat-awareness-radius
  hide-cover-threshold
  critical-threat-distance
  flee-threat-distance
  seek-cover-radius
  minimum-cover-target
  minimum-cover-improvement

  ;; Detection equation settings
  cover-impact-strength
  hide-detection-multiplier
  motion-detection-multiplier

  ;; Environment settings
  reef-cluster-count
  reef-cluster-radius

  ;; Strategy and display settings
  octopus-strategy-mode
  show-predator-radii?
  show-state-labels?

  ;; Analytics
  starting-octopus-count
  total-captures
  pursuit-events
]

patches-own [
  cover-density
]

breed [octopuses octopus]
breed [predators predator]

octopuses-own [
  policy
  active-strategy
  reaction-timer
  is-reacting?
  is-hidden?
  is-moving?
  prey-speed
]

predators-own [
  detection-radius
  pred-speed
  target-prey
]

;; ====================================================================
;; DEFAULT PARAMETERS
;; ====================================================================

to set-default-parameters
  ;; Population
  set initial-octopuses 40
  set initial-predators 3

  ;; Movement and detection
  set predator-detection-radius-setting 10
  set predator-speed-setting 0.8
  set prey-speed-setting 0.6
  set prey-reaction-time-setting 2
  set capture-distance 0.5

  ;; Predator wandering
  set predator-wander-angle 15
  set predator-search-speed-factor 0.5

  ;; Adaptive strategy thresholds
  set threat-awareness-radius 10
  set hide-cover-threshold 0.55
  set critical-threat-distance 3
  set flee-threat-distance 6
  set seek-cover-radius 5
  set minimum-cover-target 0.6
  set minimum-cover-improvement 0.1

  ;; Detection model
  set cover-impact-strength 0.8
  set hide-detection-multiplier 0.15
  set motion-detection-multiplier 1.5

  ;; Environment
  set reef-cluster-count 15
  set reef-cluster-radius 3

  ;; Strategy mode:
  ;; "adaptive-dmas"
  ;; "experimental-assigned"
  ;; "hide"
  ;; "flee"
  ;; "still"
  ;; "seek-cover"
  set octopus-strategy-mode "adaptive-dmas"

  ;; Visual options
  set show-predator-radii? true
  set show-state-labels? true
end

;; ====================================================================
;; SETUP
;; ====================================================================

to setup
  clear-all
  set-default-parameters

  set total-captures 0
  set pursuit-events 0

  setup-environment
  setup-octopuses
  setup-predators

  set starting-octopus-count count octopuses

  reset-ticks
  render-predator-perception
  safely-update-live-plots
end

to setup-environment
  ask patches [
    set cover-density random-float 0.10
  ]

  let cluster-count min (list reef-cluster-count count patches)

  if cluster-count > 0 [
    ask n-of cluster-count patches [
      let cluster-center self

      ask patches in-radius reef-cluster-radius [
        let divisor max (list 0.1 reef-cluster-radius)
        let normalized-distance distance cluster-center / divisor
        let cluster-strength max (list 0 (1 - normalized-distance))

        set cover-density min
          (list 1
            (cover-density
              + cluster-strength
              * (0.25 + random-float 0.65)))
      ]
    ]
  ]

  recolor-environment
end

to recolor-environment
  ask patches [
    ifelse cover-density < 0.15 [
      set pcolor 37
    ] [
      set pcolor scale-color green cover-density -0.10 1.10
    ]
  ]
end

to setup-octopuses
  create-octopuses initial-octopuses [
    setxy random-xcor random-ycor

    set shape "bug"
    set color orange
    set size 1.1

    set prey-speed prey-speed-setting
    set reaction-timer prey-reaction-time-setting
    set is-reacting? false
    set is-hidden? false
    set is-moving? false
    set active-strategy "still"

    ifelse octopus-strategy-mode = "experimental-assigned" [
      set policy one-of ["hide" "flee" "still" "seek-cover"]
    ] [
      set policy octopus-strategy-mode
    ]

    update-octopus-visuals
  ]
end

to setup-predators
  create-predators initial-predators [
    setxy random-xcor random-ycor

    set shape "fish"
    set color red
    set size 1.8

    set detection-radius predator-detection-radius-setting
    set pred-speed predator-speed-setting
    set target-prey nobody

    set label ""

    if show-state-labels? [
      set label "SEARCH"
      set label-color white
    ]
  ]
end

;; ====================================================================
;; MAIN LOOP
;; ====================================================================

to go
  if not any? octopuses [
    render-predator-perception
    stop
  ]

  ask octopuses [
    execute-prey-logic
  ]

  ask predators [
    execute-predator-logic
  ]

  render-predator-perception

  tick
  safely-update-live-plots
end

;; ====================================================================
;; PREY LOGIC
;; ====================================================================

to execute-prey-logic
  let nearest-threat nobody

  if any? predators [
    set nearest-threat min-one-of predators [
      distance myself
    ]
  ]

  select-active-strategy nearest-threat

  let threat-present? false

  if nearest-threat != nobody [
    if distance nearest-threat <= threat-awareness-radius [
      set threat-present? true
    ]
  ]

  ifelse threat-present? [
    if reaction-timer > 0 [
      set reaction-timer reaction-timer - 1
      set is-reacting? true
      set is-hidden? false
      set is-moving? false

      update-octopus-visuals
      stop
    ]
  ] [
    set reaction-timer prey-reaction-time-setting
  ]

  set is-reacting? false

  if active-strategy = "hide" [
    perform-hide
  ]

  if active-strategy = "still" [
    perform-still
  ]

  if active-strategy = "flee" [
    perform-flee nearest-threat
  ]

  if active-strategy = "seek-cover" [
    perform-seek-cover
  ]

  update-octopus-visuals
end

to select-active-strategy [threat]
  ifelse policy = "adaptive-dmas" [
    evaluate-adaptive-strategy threat
  ] [
    set active-strategy policy
  ]
end

to evaluate-adaptive-strategy [threat]
  if threat = nobody [
    set active-strategy "still"
    stop
  ]

  let threat-distance distance threat
  let local-cover cover-density

  if threat-distance > threat-awareness-radius [
    set active-strategy "still"
    stop
  ]

  if local-cover >= hide-cover-threshold [
    set active-strategy "hide"
    stop
  ]

  if threat-distance <= critical-threat-distance [
    set active-strategy "flee"
    stop
  ]

  let target-cover-patch max-one-of
    (patches in-radius seek-cover-radius)
    [cover-density]

  let useful-cover-available? false

  if target-cover-patch != nobody [
    let target-cover [cover-density] of target-cover-patch

    if target-cover >= minimum-cover-target [
      if target-cover >= local-cover + minimum-cover-improvement [
        set useful-cover-available? true
      ]
    ]
  ]

  if useful-cover-available? [
    set active-strategy "seek-cover"
    stop
  ]

  ifelse threat-distance <= flee-threat-distance [
    set active-strategy "flee"
  ] [
    set active-strategy "still"
  ]
end

;; ====================================================================
;; PREY ACTIONS
;; ====================================================================

to perform-hide
  set is-hidden? true
  set is-moving? false
end

to perform-still
  set is-hidden? false
  set is-moving? false
end

to perform-flee [threat]
  set is-hidden? false

  ifelse threat != nobody [
    set is-moving? true
    face threat
    rt 180
    safe-forward prey-speed
  ] [
    set is-moving? false
  ]
end

to perform-seek-cover
  let target-patch max-one-of
    (patches in-radius seek-cover-radius)
    [cover-density]

  if cover-density >= minimum-cover-target [
    set active-strategy "hide"
    set is-hidden? true
    set is-moving? false
    stop
  ]

  let useful-target? false

  if target-patch != nobody [
    if [cover-density] of target-patch >=
       cover-density + minimum-cover-improvement [
      set useful-target? true
    ]
  ]

  ifelse useful-target? [
    set is-hidden? false
    set is-moving? true
    face target-patch
    safe-forward prey-speed
  ] [
    set active-strategy "still"
    set is-hidden? false
    set is-moving? false
  ]
end

to safe-forward [step-size]
  if step-size <= 0 [
    stop
  ]

  ifelse can-move? step-size [
    fd step-size
  ] [
    rt (150 + random 61)

    if can-move? step-size [
      fd step-size
    ]
  ]
end

;; ====================================================================
;; OCTOPUS VISUALS
;; ====================================================================

to update-octopus-visuals
  set label ""
  set label-color white

  if is-reacting? [
    set color magenta
    set size 1.2

    if show-state-labels? [
      set label word "WAIT " reaction-timer
    ]

    stop
  ]

  if is-hidden? [
    set color pcolor
    set size 0.72

    if show-state-labels? [
      set label "HIDE"
      set label-color yellow
    ]

    stop
  ]

  if active-strategy = "flee" [
    set color yellow
    set size 1.25

    if show-state-labels? [
      set label "FLEE"
    ]

    stop
  ]

  if active-strategy = "seek-cover" [
    set color cyan
    set size 1.05

    if show-state-labels? [
      set label "SEEK"
    ]

    stop
  ]

  set color orange
  set size 1

  if show-state-labels? [
    set label "STILL"
  ]
end

;; ====================================================================
;; PREDATOR LOGIC
;; ====================================================================

to execute-predator-logic
  let visible-prey octopuses with [
    is-detected-by? myself
  ]

  ifelse any? visible-prey [
    let selected-prey min-one-of visible-prey [
      distance myself
    ]

    if selected-prey != target-prey [
      set pursuit-events pursuit-events + 1
    ]

    set target-prey selected-prey

    set label ""

    if show-state-labels? [
      set label "CHASE"
      set label-color yellow
    ]

    if target-prey != nobody [
      face target-prey

      let distance-to-target distance target-prey
      let movement-distance min
        (list pred-speed distance-to-target)

      safe-forward movement-distance

      if target-prey != nobody [
        if distance target-prey <= capture-distance [
          ask target-prey [
            die
          ]

          set total-captures total-captures + 1
          set target-prey nobody
        ]
      ]
    ]
  ] [
    set target-prey nobody
    set label ""

    if show-state-labels? [
      set label "SEARCH"
      set label-color white
    ]

    rt (random-float (2 * predator-wander-angle)
      - predator-wander-angle)

    safe-forward
      (pred-speed * predator-search-speed-factor)
  ]
end

to-report is-detected-by? [pred]
  if pred = nobody [
    report false
  ]

  let distance-to-predator distance pred
  let base-radius [detection-radius] of pred

  let local-cover max
    (list 0 (min (list 1 cover-density)))

  let hide-modifier 1

  if is-hidden? [
    set hide-modifier hide-detection-multiplier
  ]

  let motion-modifier 1

  if is-moving? [
    set motion-modifier motion-detection-multiplier
  ]

  let cover-modifier max
    (list 0
      (1 - local-cover * cover-impact-strength))

  let effective-radius
    base-radius
    * cover-modifier
    * hide-modifier
    * motion-modifier

  set effective-radius max
    (list 0 effective-radius)

  report distance-to-predator <= effective-radius
end

;; ====================================================================
;; PREDATOR PERCEPTION RINGS
;; ====================================================================

to render-predator-perception
  clear-drawing

  if not show-predator-radii? [
    stop
  ]

  ask predators [
    draw-perception-ring detection-radius red
    draw-perception-ring reference-detection-radius cyan
  ]
end

to-report reference-detection-radius
  let local-cover max
    (list 0 (min (list 1 cover-density)))

  let cover-modifier max
    (list 0
      (1 - local-cover * cover-impact-strength))

  report detection-radius * cover-modifier
end

to draw-perception-ring [radius ring-color]
  if radius <= 0 [
    stop
  ]

  let saved-x xcor
  let saved-y ycor
  let saved-heading heading
  let saved-color color

  pen-up
  set color ring-color
  set heading 0

  if not can-move? radius [
    set color saved-color
    set heading saved-heading
    stop
  ]

  fd radius
  set heading 90
  pen-down

  let segments 72
  let segment-length
    (2 * pi * radius) / segments

  repeat segments [
    fd segment-length
    rt (360 / segments)
  ]

  pen-up
  setxy saved-x saved-y
  set heading saved-heading
  set color saved-color
end

;; ====================================================================
;; ANALYTICS
;; ====================================================================

to-report survival-rate
  if starting-octopus-count <= 0 [
    report 0
  ]

  report
    100 * count octopuses
    / starting-octopus-count
end

to-report predator-capture-efficiency
  if pursuit-events <= 0 [
    report 0
  ]

  report
    100 * total-captures
    / pursuit-events
end

to-report average-cover-usage
  if not any? octopuses [
    report 0
  ]

  report mean [cover-density] of octopuses
end

to-report average-world-cover
  if not any? patches [
    report 0
  ]

  report mean [cover-density] of patches
end

to-report relative-cover-use
  let world-cover average-world-cover

  if world-cover <= 0 [
    report 0
  ]

  report average-cover-usage / world-cover
end

to-report hidden-octopus-count
  report count octopuses with [
    is-hidden?
  ]
end

to-report moving-octopus-count
  report count octopuses with [
    is-moving?
  ]
end

to-report hide-strategy-count
  report count octopuses with [
    active-strategy = "hide"
  ]
end

to-report flee-strategy-count
  report count octopuses with [
    active-strategy = "flee"
  ]
end

to-report still-strategy-count
  report count octopuses with [
    active-strategy = "still"
  ]
end

to-report seek-cover-strategy-count
  report count octopuses with [
    active-strategy = "seek-cover"
  ]
end

;; ====================================================================
;; LIVE PLOTTING
;; ====================================================================

to safely-update-live-plots
  ;; Prevents an error if the plot has not been created yet.
  carefully [
    update-live-plots
  ] [
    ;; Intentionally do nothing when the plot or pens are missing.
  ]
end

to update-live-plots
  set-current-plot
    "Prey Population by Active Strategy"

  set-current-plot-pen "Hide"
  plotxy ticks hide-strategy-count

  set-current-plot-pen "Flee"
  plotxy ticks flee-strategy-count

  set-current-plot-pen "Still"
  plotxy ticks still-strategy-count

  set-current-plot-pen "Seek Cover"
  plotxy ticks seek-cover-strategy-count

  set-current-plot-pen "Total"
  plotxy ticks count octopuses
end]]></code>
  <widgets>
    <view x="180" wrappingAllowedX="true" y="0" frameRate="30.0" minPycor="-25" height="565" showTickCounter="true" patchSize="11.0" fontSize="10" wrappingAllowedY="true" width="565" tickCounterLabel="ticks" maxPycor="25" updateMode="0" maxPxcor="25" minPxcor="-25"></view>
    <button x="5" y="50" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55">go</button>
    <button x="5" y="5" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55">setup</button>
  </widgets>
