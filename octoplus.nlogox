<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;; ====================================================================
;; HIDE OR FLEE?
;; Adaptive Predator-Prey Multi-Agent Simulation
;; NetLogo 7.0.4
;;
;; Research question:
;; Under which environmental and predator-prey conditions is it better
;; for prey to stay still, hide, flee, or seek nearby cover?
;; ====================================================================

globals [
  ;; ------------------------------------------------------------
  ;; MODEL CONSTANTS
  ;;
  ;; These are parameters no experiment varies. They are set once in
  ;; set-model-constants rather than given Interface widgets, because a
  ;; slider that every experiment pins to the same value is surface
  ;; area with no purpose. Any of them can be promoted back to a
  ;; slider in one step if it becomes a variable of interest.
  ;; ------------------------------------------------------------
  capture-distance
  predator-wander-angle
  predator-search-speed-factor
  threat-awareness-radius
  critical-threat-distance
  seek-cover-radius
  minimum-cover-improvement
  reef-cluster-count
  reef-cluster-radius
  maturity-age
  reproduction-cooldown-setting
  mating-radius
  offspring-per-birth
  carrying-capacity

  ;; ------------------------------------------------------------
  ;; NOTE ON REMAINING PARAMETERS
  ;;
  ;; All experimental parameters are now Interface widgets
  ;; (sliders, choosers, switches) and are therefore global
  ;; variables created by the Interface rather than declared here.
  ;; Declaring them here as well would be a duplicate definition.
  ;;
  ;; Only derived values and analytics are declared below.
  ;; ------------------------------------------------------------

  ;; ------------------------------------------------------------
  ;; Derived environment values
  ;; ------------------------------------------------------------
  target-cover-mean
  realized-cover-mean

  ;; ------------------------------------------------------------
  ;; Population analytics
  ;; ------------------------------------------------------------
  starting-octopus-count
  total-captures
  cumulative-survival
  founder-cumulative-survival
  extinction-tick

  ;; ------------------------------------------------------------
  ;; Predator analytics
  ;; ------------------------------------------------------------
  pursuit-events
  detection-events

  ;; ------------------------------------------------------------
  ;; Decision analytics
  ;;
  ;; These count transitions into a strategy. An octopus remaining
  ;; hidden for 20 ticks therefore produces one hide decision rather
  ;; than 20 repeated hide decisions.
  ;; ------------------------------------------------------------
  hide-decisions
  flee-decisions
  still-decisions
  seek-cover-decisions

  ;; ------------------------------------------------------------
  ;; Strategy exposure analytics
  ;;
  ;; Decision counts measure how often a strategy was CHOSEN.
  ;; Exposure measures how many agent-ticks were SPENT in it, which
  ;; is the quantity that actually determines detection risk.
  ;; ------------------------------------------------------------
  hide-agent-ticks
  flee-agent-ticks
  still-agent-ticks
  seek-cover-agent-ticks
  reacting-agent-ticks

  ;; ------------------------------------------------------------
  ;; Capture-time analytics
  ;; ------------------------------------------------------------
  capture-ticks
  first-capture-tick
  last-capture-tick

  ;; ------------------------------------------------------------
  ;; Reproduction analytics
  ;; ------------------------------------------------------------
  total-births

  ;; ------------------------------------------------------------
  ;; Render and plot guards
  ;;
  ;; These keep headless BehaviorSpace runs from paying for drawing
  ;; and plotting work that has no visible effect.
  ;; ------------------------------------------------------------
  rings-drawn?
  plot-updates-unavailable?
]

patches-own [
  ;; Continuous environmental cover in the range 0 to 1.
  cover-density
]

breed [octopuses octopus]
breed [predators predator]

octopuses-own [
  ;; Fixed policy assigned to this octopus.
  policy

  ;; Action currently selected by this octopus.
  active-strategy

  ;; Last strategy counted in the cumulative decision statistics.
  last-counted-strategy

  ;; Delay between detecting a threat and performing an action.
  reaction-timer
  is-reacting?

  ;; State variables used by predator detection.
  is-hidden?
  is-moving?

  ;; Individual movement speed.
  prey-speed

  ;; Reproduction state.
  sex
  age
  repro-cooldown

  ;; True for the octopuses created by setup. Founders let survival
  ;; be measured cleanly even when reproduction is enabled, because
  ;; the founder cohort is a fixed denominator.
  is-founder?

  ;; Ticks this octopus has been alive in the run.
  ticks-alive
]

predators-own [
  detection-radius
  pred-speed
  target-prey
]

;; ====================================================================
;; PARAMETERS
;;
;; Every experimental parameter is an Interface widget. Widget
;; defaults are stored in the model file, so no startup procedure is
;; needed, and none is provided on purpose: a startup procedure that
;; re-applied hard-coded defaults would discard Interface settings
;; every time the model was opened.
;;
;; validate-parameters below is a safety net only. It repairs values
;; that are impossible rather than values that are merely unusual, so
;; BehaviorSpace remains free to explore the full parameter space.
;; ====================================================================

;; Ensures that setup remains safe if the model is imported, or if an
;; Interface control supplies an invalid value.
;;
;; Valid values already supplied by BehaviorSpace or Interface widgets
;; are preserved.
to set-model-constants
  ;; Movement and capture
  set capture-distance 0.5
  set predator-wander-angle 15
  set predator-search-speed-factor 0.5

  ;; Prey perception and adaptive decision model
  set threat-awareness-radius 10
  set critical-threat-distance 3
  set seek-cover-radius 5
  set minimum-cover-improvement 0.10

  ;; Environment shape. Cover AMOUNT is a widget; these control the
  ;; spatial pattern, which the normalisation step then rescales to the
  ;; target mean, so they do not affect how much cover exists.
  set reef-cluster-count 15
  set reef-cluster-radius 3

  ;; Reproduction
  set maturity-age 60
  set reproduction-cooldown-setting 120
  set mating-radius 2
  set offspring-per-birth 1
  set carrying-capacity 250
end

to validate-parameters
  if initial-octopuses < 1 [
    set initial-octopuses 40
  ]

  if initial-predators < 0 [
    set initial-predators 3
  ]

  if predator-detection-radius-setting <= 0 [
    set predator-detection-radius-setting 10
  ]

  if predator-speed-setting < 0 [
    set predator-speed-setting 0.8
  ]

  if prey-speed-setting < 0 [
    set prey-speed-setting 0.6
  ]

  if prey-reaction-time-setting < 0 [
    set prey-reaction-time-setting 2
  ]

  if capture-distance <= 0 [
    set capture-distance 0.5
  ]

  if predator-wander-angle < 0 [
    set predator-wander-angle 15
  ]

  if predator-search-speed-factor < 0 [
    set predator-search-speed-factor 0.5
  ]

  if threat-awareness-radius <= 0 [
    set threat-awareness-radius 10
  ]

  if hide-cover-threshold < 0 or hide-cover-threshold > 1 [
    set hide-cover-threshold 0.55
  ]

  if critical-threat-distance < 0 [
    set critical-threat-distance 3
  ]

  if seek-cover-radius <= 0 [
    set seek-cover-radius 5
  ]

  if minimum-cover-target < 0 or minimum-cover-target > 1 [
    set minimum-cover-target 0.60
  ]

  if minimum-cover-improvement < 0 [
    set minimum-cover-improvement 0.10
  ]

  if minimum-decision-score < 0 [
    set minimum-decision-score 0.08
  ]

  if cover-impact-strength < 0 or cover-impact-strength > 1 [
    set cover-impact-strength 0.8
  ]

  if hide-detection-multiplier < 0 or
     hide-detection-multiplier > 1 [
    set hide-detection-multiplier 0.15
  ]

  if motion-detection-multiplier < 0 [
    set motion-detection-multiplier 1.5
  ]

  if reef-cluster-count < 0 [
    set reef-cluster-count 15
  ]

  if reef-cluster-radius <= 0 [
    set reef-cluster-radius 3
  ]

  if not member? cover-amount-category
    ["low" "medium" "high"] [
    set cover-amount-category "medium"
  ]

  if not member? cover-arrangement
    ["uniform" "patchy" "mixed"] [
    set cover-arrangement "patchy"
  ]

  if not member? octopus-strategy-mode
    ["adaptive-dmas"
     "hide"
     "flee"
     "still"
     "seek-cover"
     "experimental-assigned"] [
    set octopus-strategy-mode "adaptive-dmas"
  ]

  if experiment-duration <= 0 [
    set experiment-duration 500
  ]

  if maturity-age < 0 [
    set maturity-age 60
  ]

  if reproduction-cooldown-setting < 0 [
    set reproduction-cooldown-setting 120
  ]

  if mating-radius <= 0 [
    set mating-radius 2
  ]

  if offspring-per-birth < 1 [
    set offspring-per-birth 1
  ]

  if carrying-capacity < 0 [
    set carrying-capacity 250
  ]

  ;; NetLogo random-seed expects an integer.
  set experiment-seed round experiment-seed
end

;; ====================================================================
;; SETUP
;; ====================================================================

to setup
  set-model-constants
  validate-parameters

  ;; Do not use clear-all here because clear-all would reset parameters
  ;; supplied by Interface widgets or BehaviorSpace.
  clear-turtles
  clear-patches
  clear-drawing
  clear-all-plots

  ;; Apply the seed before any random environment or agent setup.
  random-seed experiment-seed

  reset-analytics
  setup-environment
  setup-octopuses
  setup-predators

  set starting-octopus-count count octopuses
  set realized-cover-mean average-world-cover

  reset-ticks
  render-predator-perception
  safely-update-live-plots
end

to reset-analytics
  set starting-octopus-count 0
  set founder-cumulative-survival 0
  set extinction-tick -1
  set rings-drawn? false
  set plot-updates-unavailable? false

  set hide-agent-ticks 0
  set flee-agent-ticks 0
  set still-agent-ticks 0
  set seek-cover-agent-ticks 0
  set reacting-agent-ticks 0
  set total-captures 0
  set cumulative-survival 0

  set pursuit-events 0
  set detection-events 0

  set hide-decisions 0
  set flee-decisions 0
  set still-decisions 0
  set seek-cover-decisions 0

  set capture-ticks []
  set first-capture-tick -1
  set last-capture-tick -1

  set total-births 0
end

;; ====================================================================
;; ENVIRONMENT
;; ====================================================================

to setup-environment
  set target-cover-mean cover-target-for-category

  if cover-arrangement = "uniform" [
    setup-uniform-cover
  ]

  if cover-arrangement = "patchy" [
    setup-patchy-cover
  ]

  if cover-arrangement = "mixed" [
    setup-mixed-cover
  ]

  normalize-cover-to-target target-cover-mean
  clamp-cover-values

  set realized-cover-mean average-world-cover
  recolor-environment
end

to-report cover-target-for-category
  if cover-amount-category = "low" [
    report 0.15
  ]

  if cover-amount-category = "medium" [
    report 0.45
  ]

  if cover-amount-category = "high" [
    report 0.75
  ]

  report 0.45
end

;; A uniform environment has small local variation around the target.
to setup-uniform-cover
  ask patches [
    set cover-density
      clamp-value
        (target-cover-mean + random-normal 0 0.035)
        0
        1
  ]
end

;; A patchy environment begins with very little background cover.
;; Spatial clusters then create separated high-cover areas.
to setup-patchy-cover
  ask patches [
    set cover-density random-float 0.025
  ]

  add-cover-clusters 1
end

;; A mixed environment combines moderate background cover and clusters.
to setup-mixed-cover
  ask patches [
    set cover-density
      clamp-value
        ((target-cover-mean * 0.35) + random-float 0.08)
        0
        1
  ]

  add-cover-clusters 0.75
end

to add-cover-clusters [strength-factor]
  let cluster-count
    min (list reef-cluster-count count patches)

  if cluster-count <= 0 [
    stop
  ]

  ask n-of cluster-count patches [
    let cluster-center self

    ask patches in-radius reef-cluster-radius [
      let divisor max (list 0.1 reef-cluster-radius)
      let normalized-distance
        distance cluster-center / divisor

      let cluster-strength
        max (list 0 (1 - normalized-distance))

      let random-strength
        0.30 + random-float 0.70

      set cover-density
        cover-density
        + cluster-strength
        * random-strength
        * strength-factor
    ]
  ]
end

;; Adjusts mean cover without removing the spatial pattern.
;;
;; If the current mean is below the target, every patch moves toward 1
;; proportionally. If it is above the target, every patch is scaled
;; proportionally toward 0.
to normalize-cover-to-target [target-mean]
  let bounded-target clamp-value target-mean 0 1
  let current-mean mean [cover-density] of patches

  if current-mean < bounded-target [
    if current-mean < 1 [
      let increase-proportion
        (bounded-target - current-mean)
        / (1 - current-mean)

      ask patches [
        set cover-density
          cover-density
          + (1 - cover-density) * increase-proportion
      ]
    ]
  ]

  if current-mean > bounded-target [
    if current-mean > 0 [
      let reduction-factor
        bounded-target / current-mean

      ask patches [
        set cover-density
          cover-density * reduction-factor
      ]
    ]
  ]
end

to clamp-cover-values
  ask patches [
    set cover-density clamp-value cover-density 0 1
  ]
end

to recolor-environment
  ask patches [
    ifelse cover-density < 0.15 [
      set pcolor 37
    ] [
      set pcolor
        scale-color green cover-density -0.10 1.10
    ]
  ]
end

to-report clamp-value [value minimum-value maximum-value]
  report max
    (list minimum-value
      (min (list maximum-value value)))
end

;; ====================================================================
;; AGENT SETUP
;; ====================================================================

to setup-octopuses
  create-octopuses initial-octopuses [
    setxy random-xcor random-ycor

    set shape "bug"
    set color orange
    set size 1.1

    set prey-speed prey-speed-setting
    set reaction-timer prey-reaction-time-setting
    set is-reacting? false
    set is-hidden? false
    set is-moving? false

    set active-strategy "still"
    set last-counted-strategy ""

    set is-founder? true
    set ticks-alive 0

    ;; Founders are adults ready to breed immediately.
    ifelse random 2 = 0 [
      set sex "female"
    ] [
      set sex "male"
    ]
    set age maturity-age
    set repro-cooldown 0

    ifelse octopus-strategy-mode = "experimental-assigned" [
      set policy one-of
        ["hide" "flee" "still" "seek-cover"]
    ] [
      set policy octopus-strategy-mode
    ]

    update-octopus-visuals
  ]
end

to setup-predators
  create-predators initial-predators [
    setxy random-xcor random-ycor

    set shape "fish"
    set color red
    set size 1.8

    set detection-radius
      predator-detection-radius-setting

    set pred-speed predator-speed-setting
    set target-prey nobody

    update-predator-search-visual
  ]
end

;; ====================================================================
;; MAIN LOOP
;; ====================================================================

to go
  if run-complete? [
    render-predator-perception
    stop
  ]

  ask octopuses [
    execute-prey-logic
  ]

  ask predators [
    execute-predator-logic
  ]

  ;; Cumulative survival is measured in octopus-ticks.
  ;; It is the number of surviving octopuses after predation in each
  ;; completed simulation tick, summed over the run.
  set cumulative-survival
    cumulative-survival + count octopuses

  ;; The founder cohort is a fixed denominator, so founder-ticks stay
  ;; interpretable as survival even when reproduction is enabled.
  set founder-cumulative-survival
    founder-cumulative-survival
    + count octopuses with [is-founder?]

  if not any? octopuses [
    if extinction-tick = -1 [
      set extinction-tick ticks
    ]
  ]

  tick

  render-predator-perception
  safely-update-live-plots
end

to-report run-complete?
  report
    ticks >= experiment-duration
    or not any? octopuses
end

;; ====================================================================
;; PREY PERCEPTION AND DECISION LOGIC
;; ====================================================================

to execute-prey-logic
  advance-life-clock

  let nearest-threat nearest-predator

  select-active-strategy nearest-threat

  let threat-present?
    threat-is-relevant? nearest-threat

  ifelse threat-present? [
    if reaction-timer > 0 [
      set reaction-timer reaction-timer - 1
      set is-reacting? true
      set is-hidden? false
      set is-moving? false

      set reacting-agent-ticks reacting-agent-ticks + 1

      update-octopus-visuals
      stop
    ]
  ] [
    set reaction-timer prey-reaction-time-setting
  ]

  set is-reacting? false

  if active-strategy = "hide" [
    perform-hide
  ]

  if active-strategy = "still" [
    perform-still
  ]

  if active-strategy = "flee" [
    perform-flee nearest-threat
  ]

  if active-strategy = "seek-cover" [
    perform-seek-cover nearest-threat
  ]

  ;; Count only transitions into a new strategy.
  record-strategy-transition

  ;; Count every tick spent in the strategy. Detection risk accrues
  ;; per tick, not per decision, so exposure is the quantity that
  ;; links behaviour to outcome.
  record-strategy-exposure

  update-octopus-visuals

  try-reproduce
end

;; Ageing and cooldown advance once per tick for every living prey,
;; independently of whether it acts this tick.
to advance-life-clock
  set ticks-alive ticks-alive + 1
  set age age + 1

  if repro-cooldown > 0 [
    set repro-cooldown repro-cooldown - 1
  ]
end

to record-strategy-exposure
  if active-strategy = "hide" [
    set hide-agent-ticks hide-agent-ticks + 1
    stop
  ]

  if active-strategy = "flee" [
    set flee-agent-ticks flee-agent-ticks + 1
    stop
  ]

  if active-strategy = "still" [
    set still-agent-ticks still-agent-ticks + 1
    stop
  ]

  if active-strategy = "seek-cover" [
    set seek-cover-agent-ticks
      seek-cover-agent-ticks + 1
  ]
end

to-report nearest-predator
  if not any? predators [
    report nobody
  ]

  report min-one-of predators [
    distance myself
  ]
end

to-report threat-is-relevant? [threat]
  if threat = nobody [
    report false
  ]

  report distance threat <= threat-awareness-radius
end

to select-active-strategy [threat]
  ifelse policy = "adaptive-dmas" [
    evaluate-adaptive-strategy threat
  ] [
    set active-strategy policy
  ]
end

;; Adaptive policy:
;;
;; 1. Stay still when there is no predator in awareness range.
;; 2. Flee when the predator is critically close.
;; 3. Seek cover when better cover is useful, reachable, and offers
;;    greater projected value than immediately hiding or fleeing.
;; 4. Otherwise compare the local hide and flee scores.
;; 5. Stay still when both scores are negligible.
to evaluate-adaptive-strategy [threat]
  if not threat-is-relevant? threat [
    set active-strategy "still"
    stop
  ]

  let threat-distance distance threat

  ;; Emergency response.
  if threat-distance <= critical-threat-distance [
    set active-strategy "flee"
    stop
  ]

  let current-hide-score hide-score threat
  let current-flee-score flee-score threat

  let target-patch best-cover-patch
  let should-seek? false

  if target-patch != nobody [
    if useful-cover-target? target-patch [
      if cover-target-is-reachable? target-patch threat [
        let projected-hide-score
          hide-score-at-cover
            [cover-density] of target-patch
            threat

        if projected-hide-score > current-hide-score [
          if projected-hide-score > current-flee-score [
            set should-seek? true
          ]
        ]
      ]
    ]
  ]

  if should-seek? [
    set active-strategy "seek-cover"
    stop
  ]

  if max
    (list current-hide-score current-flee-score)
    < minimum-decision-score [
    set active-strategy "still"
    stop
  ]

  ifelse current-hide-score >= current-flee-score [
    set active-strategy "hide"
  ] [
    set active-strategy "flee"
  ]
end

;; Hiding becomes more valuable when:
;; - local cover is strong;
;; - camouflage has a strong effect;
;; - the threat has not already reached critical distance.
;;
;; Score is constrained to 0..1.
to-report hide-score [threat]
  report hide-score-at-cover cover-density threat
end

to-report hide-score-at-cover [candidate-cover threat]
  if threat = nobody [
    report 0
  ]

  let bounded-cover clamp-value candidate-cover 0 1
  let camouflage-strength
    clamp-value
      (1 - hide-detection-multiplier)
      0
      1

  let urgency threat-urgency threat

  ;; Hiding becomes somewhat less attractive when the predator is
  ;; already very close, but emergency behavior is handled separately.
  let reaction-safety
    clamp-value (1 - 0.35 * urgency) 0 1

  report clamp-value
    (bounded-cover
      * camouflage-strength
      * reaction-safety)
    0
    1
end

;; Fleeing becomes more valuable when:
;; - the predator is close;
;; - prey speed is competitive with predator speed.
;;
;; Score is constrained to 0..1.
to-report flee-score [threat]
  if threat = nobody [
    report 0
  ]

  let predator-speed
    max (list 0.01 [pred-speed] of threat)

  let relative-speed
    clamp-value
      (prey-speed / predator-speed)
      0
      1

  report clamp-value
    (threat-urgency threat * relative-speed)
    0
    1
end

to-report threat-urgency [threat]
  if threat = nobody [
    report 0
  ]

  if threat-awareness-radius <= 0 [
    report 1
  ]

  report clamp-value
    (1 - distance threat / threat-awareness-radius)
    0
    1
end

to-report best-cover-patch
  let nearby-patches
    patches in-radius seek-cover-radius

  if not any? nearby-patches [
    report nobody
  ]

  report max-one-of nearby-patches [
    cover-density
  ]
end

to-report useful-cover-target? [target-patch]
  if target-patch = nobody [
    report false
  ]

  let target-cover
    [cover-density] of target-patch

  report
    target-cover >= minimum-cover-target
    and target-cover
      >= cover-density + minimum-cover-improvement
end

;; This is a simple local reachability estimate, not a prediction of the
;; predator's complete future route.
to-report cover-target-is-reachable? [target-patch threat]
  if target-patch = nobody [
    report false
  ]

  if threat = nobody [
    report true
  ]

  if prey-speed <= 0 [
    report false
  ]

  let travel-time
    distance target-patch / prey-speed

  let predator-speed
    max (list 0.01 [pred-speed] of threat)

  let estimated-threat-arrival
    distance threat / predator-speed

  report travel-time < estimated-threat-arrival
end

;; ====================================================================
;; PREY ACTIONS
;; ====================================================================

to perform-hide
  set is-hidden? true
  set is-moving? false
end

to perform-still
  set is-hidden? false
  set is-moving? false
end

to perform-flee [threat]
  set is-hidden? false

  ifelse threat != nobody [
    set is-moving? true
    face threat
    rt 180
    safe-forward prey-speed
  ] [
    set is-moving? false
  ]
end

to perform-seek-cover [threat]
  let target-patch best-cover-patch

  ;; Once usable cover has been reached, transition into hiding.
  if cover-density >= minimum-cover-target [
    set active-strategy "hide"
    set is-hidden? true
    set is-moving? false
    stop
  ]

  ifelse useful-cover-target? target-patch [
    ifelse cover-target-is-reachable? target-patch threat [
      set is-hidden? false
      set is-moving? true
      face target-patch
      safe-forward prey-speed
    ] [
      ;; The target is useful but cannot likely be reached in time.
      set active-strategy "flee"
      perform-flee threat
    ]
  ] [
    set active-strategy "still"
    set is-hidden? false
    set is-moving? false
  ]
end

to safe-forward [step-size]
  if step-size <= 0 [
    stop
  ]

  ifelse can-move? step-size [
    fd step-size
  ] [
    rt (150 + random 61)

    if can-move? step-size [
      fd step-size
    ]
  ]
end

;; ====================================================================
;; REPRODUCTION
;;
;; Sexual reproduction closes the population loop so that survival
;; differences between strategies are visible as steady-state
;; population levels rather than only as time-to-extinction.
;;
;; Offspring inherit the parent's policy. In experimental-assigned
;; runs this produces selection pressure over the policy mix: policies
;; that survive long enough to breed become more common, so the
;; strategy mix itself becomes an emergent outcome.
;; ====================================================================

to try-reproduce
  if not enable-reproduction? [
    stop
  ]

  ;; Ageing and cooldown are handled by advance-life-clock so that
  ;; they apply on every tick, including ticks spent reacting.

  ;; Prey that are currently dealing with a predator do not breed.
  ;;
  ;; This condition is expressed in terms of the threat situation, not
  ;; the strategy label, and that distinction matters. An earlier
  ;; version skipped reproduction whenever active-strategy was "flee".
  ;; For an adaptive prey, which flees only occasionally, that was a
  ;; reasonable "too busy escaping" rule. For the fixed flee policy it
  ;; was fatal: such a prey has active-strategy = "flee" on every tick
  ;; of its life, so it could never breed at all. The flee policy was
  ;; structurally sterile, and every reproduction-enabled comparison
  ;; against it measured that sterility rather than its survival.
  ;;
  ;; The rule below applies identically to every policy.
  if is-reacting? [
    stop
  ]

  let visible-threat nearest-predator

  if visible-threat != nobody [
    if distance visible-threat <= threat-awareness-radius [
      stop
    ]
  ]

  if sex != "female" [
    stop
  ]

  if age < maturity-age [
    stop
  ]

  if repro-cooldown > 0 [
    stop
  ]

  if count octopuses >= carrying-capacity [
    stop
  ]

  let mate one-of other octopuses in-radius mating-radius with [
    sex = "male" and age >= maturity-age
  ]

  if mate = nobody [
    stop
  ]

  hatch offspring-per-birth [
    set age 0
    set repro-cooldown reproduction-cooldown-setting
    set is-founder? false
    set ticks-alive 0

    ifelse random 2 = 0 [
      set sex "female"
    ] [
      set sex "male"
    ]

    ;; Reset transient state; policy is inherited from the parent
    ;; via hatch, which is what drives selection pressure across
    ;; generations in mixed-policy runs.
    set prey-speed prey-speed-setting
    set reaction-timer prey-reaction-time-setting
    set is-reacting? false
    set is-hidden? false
    set is-moving? false
    set active-strategy "still"
    set last-counted-strategy ""

    rt random 360
    fd 0.3

    update-octopus-visuals
  ]

  set repro-cooldown reproduction-cooldown-setting
  set total-births total-births + offspring-per-birth
end

;; ====================================================================
;; DECISION ANALYTICS
;; ====================================================================

to record-strategy-transition
  if active-strategy = last-counted-strategy [
    stop
  ]

  if active-strategy = "hide" [
    set hide-decisions hide-decisions + 1
  ]

  if active-strategy = "flee" [
    set flee-decisions flee-decisions + 1
  ]

  if active-strategy = "still" [
    set still-decisions still-decisions + 1
  ]

  if active-strategy = "seek-cover" [
    set seek-cover-decisions
      seek-cover-decisions + 1
  ]

  set last-counted-strategy active-strategy
end

;; ====================================================================
;; OCTOPUS VISUALS
;; ====================================================================

to update-octopus-visuals
  set label ""
  set label-color white

  if is-reacting? [
    set color magenta
    set size 1.2

    if show-state-labels? [
      set label word "WAIT " reaction-timer
    ]

    stop
  ]

  if is-hidden? [
    set color pcolor
    set size 0.72

    if show-state-labels? [
      set label "HIDE"
      set label-color yellow
    ]

    stop
  ]

  if active-strategy = "flee" [
    set color yellow
    set size 1.25

    if show-state-labels? [
      set label "FLEE"
    ]

    stop
  ]

  if active-strategy = "seek-cover" [
    set color cyan
    set size 1.05

    if show-state-labels? [
      set label "SEEK"
    ]

    stop
  ]

  set color orange
  set size 1

  if show-state-labels? [
    set label "STILL"
  ]
end

;; ====================================================================
;; PREDATOR LOGIC
;; ====================================================================

to execute-predator-logic
  let visible-prey octopuses with [
    is-detected-by? myself
  ]

  ifelse any? visible-prey [
    let selected-prey min-one-of visible-prey [
      distance myself
    ]

    ;; A detection event occurs when a searching predator acquires a
    ;; visible target after having no target.
    if target-prey = nobody [
      set detection-events detection-events + 1
    ]

    ;; A pursuit event occurs whenever a predator begins pursuing a
    ;; different target.
    if selected-prey != target-prey [
      set pursuit-events pursuit-events + 1
    ]

    set target-prey selected-prey
    update-predator-chase-visual

    if target-prey != nobody [
      face target-prey

      let distance-to-target
        distance target-prey

      let movement-distance
        min (list pred-speed distance-to-target)

      safe-forward movement-distance

      if target-prey != nobody [
        if distance target-prey <= capture-distance [
          record-capture

          ask target-prey [
            die
          ]

          set target-prey nobody
        ]
      ]
    ]
  ] [
    set target-prey nobody
    update-predator-search-visual

    rt
      (random-float (2 * predator-wander-angle)
        - predator-wander-angle)

    safe-forward
      (pred-speed * predator-search-speed-factor)
  ]
end

to record-capture
  set total-captures total-captures + 1
  set capture-ticks lput ticks capture-ticks

  if first-capture-tick = -1 [
    set first-capture-tick ticks
  ]

  set last-capture-tick ticks
end

to update-predator-search-visual
  set label ""

  if show-state-labels? [
    set label "SEARCH"
    set label-color white
  ]
end

to update-predator-chase-visual
  set label ""

  if show-state-labels? [
    set label "CHASE"
    set label-color yellow
  ]
end

;; ====================================================================
;; DETECTION MODEL
;; ====================================================================

;; Detection equation:
;;
;; effective radius =
;;   base predator radius
;;   * environmental cover modifier
;;   * hiding modifier
;;   * movement modifier
;;
;; Environmental cover always makes detection more difficult.
;;
;; Hiding effectiveness also depends on local cover:
;; - at cover 0, hiding modifier = 1, so hiding has no special benefit;
;; - at cover 1, the modifier reaches hide-detection-multiplier.
;;
;; Movement can increase detection through motion-detection-multiplier.
to-report is-detected-by? [pred]
  if pred = nobody [
    report false
  ]

  let distance-to-predator distance pred
  let base-radius
    max (list 0 [detection-radius] of pred)

  let local-cover
    clamp-value cover-density 0 1

  let cover-modifier
    max
      (list 0
        (1 - local-cover * cover-impact-strength))

  let hide-modifier 1

  if is-hidden? [
    set hide-modifier
      1
      - local-cover
      * (1 - hide-detection-multiplier)
  ]

  let motion-modifier 1

  if is-moving? [
    set motion-modifier
      max (list 0 motion-detection-multiplier)
  ]

  let effective-radius
    base-radius
    * cover-modifier
    * hide-modifier
    * motion-modifier

  set effective-radius
    max (list 0 effective-radius)

  report
    distance-to-predator <= effective-radius
end

;; ====================================================================
;; PREDATOR PERCEPTION RINGS
;; ====================================================================

to render-predator-perception
  ;; The drawing layer is only touched when rings are actually shown,
  ;; or once more to erase them after the switch is turned off. This
  ;; keeps headless experiment runs free of per-tick drawing cost.
  if not show-predator-radii? [
    if rings-drawn? [
      clear-drawing
      set rings-drawn? false
    ]
    stop
  ]

  clear-drawing

  ask predators [
    ;; Red shows the predator's unmodified detection radius.
    draw-perception-ring detection-radius red

    ;; Cyan shows a reference radius modified by cover on the
    ;; predator's current patch. Actual prey detection also depends
    ;; on the prey's cover, hiding state, and movement state.
    draw-perception-ring
      reference-detection-radius
      cyan
  ]

  set rings-drawn? true
end

to-report reference-detection-radius
  let local-cover
    clamp-value cover-density 0 1

  let cover-modifier
    max
      (list 0
        (1 - local-cover * cover-impact-strength))

  report
    max
      (list 0
        (detection-radius * cover-modifier))
end

to draw-perception-ring [radius ring-color]
  if radius <= 0 [
    stop
  ]

  let saved-x xcor
  let saved-y ycor
  let saved-heading heading
  let saved-color color

  pen-up
  set color ring-color
  set heading 0

  if not can-move? radius [
    set color saved-color
    set heading saved-heading
    stop
  ]

  fd radius
  set heading 90
  pen-down

  let segments 72
  let segment-length
    (2 * pi * radius) / segments

  repeat segments [
    fd segment-length
    rt (360 / segments)
  ]

  pen-up
  setxy saved-x saved-y
  set heading saved-heading
  set color saved-color
end

;; ====================================================================
;; PRIMARY OUTCOME REPORTERS
;; ====================================================================

to-report survival-rate
  if starting-octopus-count <= 0 [
    report 0
  ]

  report
    100
    * count octopuses
    / starting-octopus-count
end

to-report capture-rate
  if starting-octopus-count <= 0 [
    report 0
  ]

  report
    100
    * total-captures
    / starting-octopus-count
end

to-report predator-capture-efficiency
  if pursuit-events <= 0 [
    report 0
  ]

  report
    100
    * total-captures
    / pursuit-events
end

;; Average number of ticks survived per original octopus.
;;
;; This is useful for comparing two runs that end with the same final
;; survival rate but differ in how long prey survived.
to-report mean-survival-time-contribution
  if starting-octopus-count <= 0 [
    report 0
  ]

  report
    cumulative-survival
    / starting-octopus-count
end

;; ====================================================================
;; CAPTURE-TIME REPORTERS
;; ====================================================================

to-report mean-capture-tick
  if empty? capture-ticks [
    report -1
  ]

  report mean capture-ticks
end

to-report median-capture-tick
  if empty? capture-ticks [
    report -1
  ]

  report median capture-ticks
end

;; A result of -1 for capture-time reporters means that no capture has
;; occurred during the run.

;; ====================================================================
;; ENVIRONMENT REPORTERS
;; ====================================================================

to-report average-cover-usage
  if not any? octopuses [
    report 0
  ]

  report mean [cover-density] of octopuses
end

to-report average-world-cover
  if not any? patches [
    report 0
  ]

  report mean [cover-density] of patches
end

to-report relative-cover-use
  let world-cover average-world-cover

  if world-cover <= 0 [
    report 0
  ]

  report average-cover-usage / world-cover
end

;; Proportion of patches with enough cover to satisfy the hiding
;; threshold. The result is in the range 0..1.
to-report cover-availability
  if not any? patches [
    report 0
  ]

  report
    count patches with [
      cover-density >= hide-cover-threshold
    ]
    / count patches
end

to-report cover-availability-percent
  report 100 * cover-availability
end

;; Standard deviation indicates environmental heterogeneity.
;;
;; Low variation means cover is relatively uniform.
;; High variation means cover is concentrated unevenly.
to-report cover-variation
  if count patches <= 1 [
    report 0
  ]

  report standard-deviation [cover-density] of patches
end

;; Mean distance from every patch to the nearest usable hiding patch.
;;
;; A result of -1 means that no patch meets hide-cover-threshold.
to-report mean-distance-to-usable-cover
  let usable-cover
    patches with [
      cover-density >= hide-cover-threshold
    ]

  if not any? usable-cover [
    report -1
  ]

  report mean [
    distance
      min-one-of usable-cover [
        distance myself
      ]
  ] of patches
end

;; ====================================================================
;; DECISION REPORTERS
;; ====================================================================

to-report total-decisions
  report
    hide-decisions
    + flee-decisions
    + still-decisions
    + seek-cover-decisions
end

to-report hide-decision-proportion
  if total-decisions <= 0 [
    report 0
  ]

  report hide-decisions / total-decisions
end

to-report flee-decision-proportion
  if total-decisions <= 0 [
    report 0
  ]

  report flee-decisions / total-decisions
end

to-report still-decision-proportion
  if total-decisions <= 0 [
    report 0
  ]

  report still-decisions / total-decisions
end

to-report seek-cover-decision-proportion
  if total-decisions <= 0 [
    report 0
  ]

  report seek-cover-decisions / total-decisions
end

;; ====================================================================
;; CURRENT-STATE REPORTERS
;; ====================================================================

to-report hidden-octopus-count
  report count octopuses with [
    is-hidden?
  ]
end

to-report moving-octopus-count
  report count octopuses with [
    is-moving?
  ]
end

to-report reacting-octopus-count
  report count octopuses with [
    is-reacting?
  ]
end

to-report hide-strategy-count
  report count octopuses with [
    active-strategy = "hide"
  ]
end

to-report flee-strategy-count
  report count octopuses with [
    active-strategy = "flee"
  ]
end

to-report still-strategy-count
  report count octopuses with [
    active-strategy = "still"
  ]
end

to-report seek-cover-strategy-count
  report count octopuses with [
    active-strategy = "seek-cover"
  ]
end

;; ====================================================================
;; POPULATION AND REPRODUCTION REPORTERS
;; ====================================================================

to-report female-count
  report count octopuses with [sex = "female"]
end

to-report male-count
  report count octopuses with [sex = "male"]
end

to-report adult-count
  report count octopuses with [age >= maturity-age]
end

to-report births-per-capture
  if total-captures <= 0 [
    report -1
  ]

  report total-births / total-captures
end

to-report net-population-change
  report total-births - total-captures
end

;; Ratio above 1 means the predator is faster than the prey.
;; Ratio below 1 means the prey is faster than the predator.
to-report predator-prey-speed-ratio
  if prey-speed-setting <= 0 [
    report 0
  ]

  report
    predator-speed-setting
    / prey-speed-setting
end

;; ====================================================================
;; POLICY COMPOSITION REPORTER
;;
;; Relevant to "experimental-assigned" runs, where each founder gets a
;; random fixed policy and offspring inherit it, so the policy mix is
;; an outcome rather than a setting.
;; ====================================================================

to-report policy-count [wanted-policy]
  report count octopuses with [
    policy = wanted-policy
  ]
end

;; ====================================================================
;; FOUNDER COHORT REPORTERS
;;
;; survival-rate divides the current population by the starting
;; population. With reproduction enabled that ratio mixes survival
;; with recruitment and can exceed 100, so it is a population index
;; rather than a survival measure.
;;
;; The founder cohort is fixed at setup and never grows, so founder
;; reporters remain true survival measures under every setting.
;; ====================================================================

to-report founders-alive
  report count octopuses with [is-founder?]
end

to-report founder-survival-rate
  if starting-octopus-count <= 0 [
    report 0
  ]

  report
    100
    * founders-alive
    / starting-octopus-count
end

to-report mean-founder-survival-time
  if starting-octopus-count <= 0 [
    report 0
  ]

  report
    founder-cumulative-survival
    / starting-octopus-count
end

;; Mean age of the living founders, useful as a check that the life
;; clock advances once per tick for every agent.
to-report mean-founder-age
  let founders octopuses with [is-founder?]

  if not any? founders [
    report -1
  ]

  report mean [ticks-alive] of founders
end

;; ====================================================================
;; STRATEGY EXPOSURE REPORTERS
;;
;; Decision counts answer "how often was this chosen?".
;; Exposure answers "how much of the run was spent doing it?", which
;; is what actually determines cumulative detection risk.
;; ====================================================================

to-report total-agent-ticks
  report
    hide-agent-ticks
    + flee-agent-ticks
    + still-agent-ticks
    + seek-cover-agent-ticks
end

to-report hide-exposure-proportion
  if total-agent-ticks <= 0 [
    report 0
  ]

  report hide-agent-ticks / total-agent-ticks
end

to-report flee-exposure-proportion
  if total-agent-ticks <= 0 [
    report 0
  ]

  report flee-agent-ticks / total-agent-ticks
end

to-report still-exposure-proportion
  if total-agent-ticks <= 0 [
    report 0
  ]

  report still-agent-ticks / total-agent-ticks
end

to-report seek-cover-exposure-proportion
  if total-agent-ticks <= 0 [
    report 0
  ]

  report seek-cover-agent-ticks / total-agent-ticks
end

;; Shannon evenness of the exposure mix, on a 0..1 scale.
;;
;; 0 means the population spent the whole run in a single strategy.
;; 1 means time was divided equally across all four strategies.
;;
;; This is the summary statistic for "did the adaptive policy actually
;; behave adaptively, or did it collapse onto one fixed action?".
to-report strategy-evenness
  if total-agent-ticks <= 0 [
    report 0
  ]

  let shares
    (list
      hide-exposure-proportion
      flee-exposure-proportion
      still-exposure-proportion
      seek-cover-exposure-proportion)

  let positive-shares
    filter [a-share -> a-share > 0] shares

  if length positive-shares <= 1 [
    report 0
  ]

  let entropy
    sum map [
      a-share -> (- a-share) * ln a-share
    ] positive-shares

  report entropy / ln 4
end

;; ====================================================================
;; RUN OUTCOME REPORTERS
;; ====================================================================

;; Tick at which the population reached zero, or -1 if prey survived
;; to the end of the run. Right-censored runs report -1, which is the
;; convention survival analysis expects.
to-report extinction-time
  report extinction-tick
end

to-report population-extinct?
  report not any? octopuses
end

to-report final-tick
  report ticks
end

;; True when the run ended because time expired rather than because
;; the population died out. Survival analysis needs this flag to
;; handle censoring correctly.
to-report run-censored?
  report any? octopuses
end

;; ====================================================================
;; SELF TEST
;;
;; Automated invariant checks, runnable headless via the "self-test"
;; BehaviorSpace experiment. Each check guards a property the study
;; depends on, and two of them are regression tests for defects this
;; model actually had.
;; ====================================================================

to run-self-test
  let failures 0

  output-print "=== octoplus self test ==="

  ;; ---- 1. Environment normalisation ----------------------------
  ;; Cover amount and cover arrangement are only separable
  ;; experimental variables if every combination lands on its target
  ;; mean. Without this, a null result on arrangement means nothing.
  foreach ["low" "medium" "high"] [ a-category ->
    foreach ["uniform" "patchy" "mixed"] [ an-arrangement ->
      set cover-amount-category a-category
      set cover-arrangement an-arrangement
      setup

      let deviation
        abs (realized-cover-mean - cover-target-for-category)

      set failures
        failures
        + check
            (word "cover mean " a-category "/" an-arrangement)
            (deviation <= 0.02)
            (word "off by " (precision deviation 4))
    ]
  ]

  ;; ---- 2. Reporter bounds --------------------------------------
  set cover-amount-category "medium"
  set cover-arrangement "patchy"
  setup
  repeat 50 [ go ]

  set failures failures + check "proportions sum to 1"
    ((abs (hide-exposure-proportion
           + flee-exposure-proportion
           + still-exposure-proportion
           + seek-cover-exposure-proportion - 1) < 0.00000001
      or total-agent-ticks = 0)
     and (abs (hide-decision-proportion
               + flee-decision-proportion
               + still-decision-proportion
               + seek-cover-decision-proportion - 1) < 0.00000001
          or total-decisions = 0)) ""

  set failures failures + check "rates and cover within bounds"
    (founder-survival-rate >= 0
     and founder-survival-rate <= 100
     and strategy-evenness >= 0
     and strategy-evenness <= 1
     and min [cover-density] of patches >= 0
     and max [cover-density] of patches <= 1) ""

  ;; ---- 3. The life clock advances once per tick ----------------
  ;; REGRESSION TEST. Ageing used to live inside try-reproduce, which
  ;; is skipped while a prey is in its reaction delay, so age counted
  ;; ticks-not-spent-reacting instead of ticks lived. Maturity then
  ;; arrived later in dangerous environments than in calm ones.
  set failures failures + check "life clock = ticks elapsed"
    (mean-founder-age = ticks or founders-alive = 0)
    (word "ticks " ticks ", mean founder age " mean-founder-age)

  ;; ---- 4. Population accounting --------------------------------
  set failures failures + check "prey accounted for"
    (count octopuses
      = starting-octopus-count + total-births - total-captures) ""

  ;; ---- 5. No policy is structurally sterile --------------------
  ;; REGRESSION TEST. The reproduction guard used to read
  ;; `if active-strategy = "flee" [ stop ]`, which made the fixed flee
  ;; policy permanently sterile: zero births in 135 runs. That
  ;; inverted the conclusion of every reproduction-enabled experiment.
  set failures failures + check "every fixed policy can reproduce"
    (all-policies-can-reproduce?)
    "a fixed policy produced no births at all"

  ;; ---- 6. Determinism ------------------------------------------
  ;; The paired statistical analysis depends on a seed reproducing the
  ;; same world, so it is asserted rather than assumed.
  set failures failures + check "same seed reproduces run"
    (deterministic-replay?) ""

  output-print ""
  ifelse failures = 0 [
    output-print "RESULT: PASS"
  ] [
    output-print (word "RESULT: FAIL (" failures " checks failed)")
  ]
end

;; Runs each fixed policy briefly with reproduction forced on, in a
;; predator-free world, and reports whether every one of them produced
;; at least one birth.
to-report all-policies-can-reproduce?
  let saved-mode octopus-strategy-mode
  let saved-predators initial-predators
  let saved-repro enable-reproduction?
  let saved-duration experiment-duration

  set initial-predators 0
  set enable-reproduction? true
  set experiment-duration 200

  let every-policy-bred? true

  foreach ["hide" "flee" "still" "seek-cover" "adaptive-dmas"] [
    a-policy ->
      set octopus-strategy-mode a-policy
      setup
      repeat 150 [ go ]

      if total-births <= 0 [
        set every-policy-bred? false
        output-print (word "        policy " a-policy
                           " produced no births")
      ]
  ]

  set octopus-strategy-mode saved-mode
  set initial-predators saved-predators
  set enable-reproduction? saved-repro
  set experiment-duration saved-duration

  report every-policy-bred?
end

;; Runs the same seed twice and compares the resulting state.
to-report deterministic-replay?
  let saved-duration experiment-duration
  set experiment-duration 60

  setup
  repeat 60 [ go ]
  let first-signature run-signature

  setup
  repeat 60 [ go ]
  let second-signature run-signature

  set experiment-duration saved-duration
  report first-signature = second-signature
end

to-report run-signature
  report (list
    count octopuses
    total-captures
    total-births
    hide-decisions
    flee-decisions
    still-decisions
    seek-cover-decisions
    precision cumulative-survival 6
    precision realized-cover-mean 8
    precision (sum [xcor + ycor] of turtles) 6)
end

;; Reports 0 when the condition holds and 1 when it fails, so that
;; callers can accumulate a failure count.
to-report check [check-name condition detail]
  if condition [
    output-print (word "  ok    " check-name)
    report 0
  ]

  let suffix ""

  if detail != "" [
    set suffix (word "  -- " detail)
  ]

  output-print (word "  FAIL  " check-name suffix)
  report 1
end

;; ====================================================================
;; LIVE PLOTTING
;; ====================================================================

to safely-update-live-plots
  ;; Plotting is skipped outright when the switch is off, which is how
  ;; BehaviorSpace runs avoid paying for plot updates nobody reads.
  if not update-live-plots? [
    stop
  ]

  ;; Allows the model to run before the optional plot and pens have
  ;; been created in the Interface. Once plotting is known to be
  ;; unavailable it is not retried, because `carefully` on every tick
  ;; is itself a measurable cost over a long run.
  if plot-updates-unavailable? [
    stop
  ]

  carefully [
    update-live-plots
  ] [
    set plot-updates-unavailable? true
  ]
end

to update-live-plots
  set-current-plot
    "Prey Population by Active Strategy"

  set-current-plot-pen "Hide"
  plotxy ticks hide-strategy-count

  set-current-plot-pen "Flee"
  plotxy ticks flee-strategy-count

  set-current-plot-pen "Still"
  plotxy ticks still-strategy-count

  set-current-plot-pen "Seek Cover"
  plotxy ticks seek-cover-strategy-count

  set-current-plot-pen "Total"
  plotxy ticks count octopuses

  set-current-plot "Population and Predation"

  set-current-plot-pen "Prey"
  plotxy ticks count octopuses

  set-current-plot-pen "Founders"
  plotxy ticks count octopuses with [is-founder?]

  set-current-plot-pen "Captures"
  plotxy ticks total-captures

  set-current-plot-pen "Births"
  plotxy ticks total-births

end
